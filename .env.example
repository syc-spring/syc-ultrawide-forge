# ===== 图像 API 配置(必填)=====
# OpenAI 兼容的 Image API Key(题目一请联系 HR 获取)
OPENAI_API_KEY=sk-xxxx

# API Base URL,默认 https://api.openai.com/v1
# 若 HR 提供的是代理/中转地址,改成对应地址(一般以 /v1 结尾)
OPENAI_BASE_URL=https://api.openai.com/v1

# 图像模型名,默认 gpt-image-1
IMAGE_MODEL=gpt-image-1

# ===== 生成策略(可选,有默认值)=====
# 单次生成 tile 的尺寸(宽x高)。需不超过所用 API 的单次上限(题目设定约 3:1)
# 默认 2172x724 = 实测中转 API 在 3:1 时的原生返回分辨率(零缩放直拼)
TILE_WIDTH=2172
TILE_HEIGHT=724
# 相邻 tile 的重叠区比例(0.05~0.5),重叠越大接缝越稳,但消耗 token 越多
OVERLAP_RATIO=0.25
# 图像质量(gpt-image-1 系支持 low/medium/high/auto;设为 default 则不发送该参数)
IMAGE_QUALITY=default
# 是否对新 tile 做色彩/亮度一致性匹配(推荐开启)
COLOR_MATCH=true
# 编辑画布待填区填充:white(兼容性最好)/ transparent / mirror
EDIT_FILL=white

# ===== LLM 分镜规划(可选)=====
# 可选:用 chat 模型为每个 tile 规划内容分镜,提升叙事连贯性。留空则用内置模板
# PLANNER_MODEL=gpt-4o-mini

# ===== 服务配置 =====
PORT=8000
# Mock 模式:设为 true 时不调用真实 API,用确定性程序化图像验证全流程
MOCK=false
